table fraud_analysis_powerbi
	lineageTag: 02693f1d-0aee-44c2-945d-9b7d4bd6c3fa

	measure 'Total Transactions' = COUNTROWS('fraud_analysis_powerbi')
		formatString: #,0
		lineageTag: 4db6aef0-3ffd-4cbd-9f8a-620c01bb9aa0

	measure 'Fraud Transactions' = SUM('fraud_analysis_powerbi'[isFraud])
		formatString: #,0
		lineageTag: 99357eb3-1da4-43bf-9120-2a03737cae21

	measure 'Fraud Rate' = DIVIDE([Fraud Transactions], [Total Transactions])
		formatString: 0.00%
		lineageTag: a6d1e40f-a899-43f9-9abf-916cb0048928

	measure 'Total Transaction Value' = SUM('fraud_analysis_powerbi'[TransactionAmt])
		formatString: #,0.00
		lineageTag: c03f321d-9e83-448a-beea-c677cc9ce484

	measure 'Fraud Transaction Value' = SUM('fraud_analysis_powerbi'[FraudValue])
		formatString: #,0.00
		lineageTag: 7ac91968-49d5-4b93-8a94-aa46bb2b5c93

	measure 'Fraud Value Share' = DIVIDE([Fraud Transaction Value], [Total Transaction Value])
		formatString: 0.00%
		lineageTag: 82197dc6-5969-490f-9a9b-f07c85143cd1

