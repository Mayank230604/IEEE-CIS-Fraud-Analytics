	partition fraud_analysis_powerbi = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FraudCsvPath), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"TransactionID", Int64.Type}, {"isFraud", Int64.Type}, {"TransactionDT", Int64.Type}, {"TransactionAmt", type number}, {"ProductCD", type text}, {"card4", type text}, {"DeviceType", type text}, {"AmountBand", type text}, {"TransactionWeek", Int64.Type}, {"FraudValue", type number}}, "en-US"),
				    NormalizedBands = Table.TransformColumns(Typed, {{"AmountBand", each Text.Replace(_, Character.FromNumber(8211), "-"), type text}}),
				    SortedBands = Table.AddColumn(NormalizedBands, "AmountBandOrder", each List.PositionOf({"0-50","50-100","100-250","250-500","500+"}, [AmountBand]), Int64.Type),
				    DisplayBands = Table.TransformColumns(SortedBands, {{"AmountBand", each Record.Field([#"0-50"="1 | 0 to <50", #"50-100"="2 | 50 to <100", #"100-250"="3 | 100 to <250", #"250-500"="4 | 250 to <500", #"500+"="5 | 500+"], _), type text}})
				in
				    DisplayBands

